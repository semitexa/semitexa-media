{
    "name": "semitexa/media",
    "description": "Semitexa Media \u2014 image-first media asset management with async variants, tenant-aware quotas, and CDN-ready delivery URLs",
    "type": "semitexa-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Semitexa",
            "email": "support@semitexa.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-imagick": "*",
        "semitexa/core": ">=2026.10.29.1052 || dev-master",
        "semitexa/orm": ">=2026.10.29.1052 || dev-master",
        "semitexa/storage": "*",
        "semitexa/tenancy": "*"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\Media\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\Media\\Tests\\": "tests/"
        }
    },
    "extra": {
        "semitexa-module": {
            "name": "media",
            "description": "Image-first media asset management: async variants, tenant-aware quotas, CDN-ready delivery URLs"
